ALTER ENTITY ResourceMonitor.ChartPoint DROP ATTRIBUTE IF EXISTS ProcessCpuMax;
ALTER ENTITY ResourceMonitor.ChartPoint DROP ATTRIBUTE IF EXISTS HeapUsedMaxMb;
ALTER ENTITY ResourceMonitor.ChartPoint DROP ATTRIBUTE IF EXISTS PhysicalFreeMb;
