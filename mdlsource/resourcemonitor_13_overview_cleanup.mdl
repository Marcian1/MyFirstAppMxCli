mdl 1;

-- Overview redesign, cleanup: remove what is user data or a secret, and what the dashboard no longer shows.
-- Run after 10, 11 and 12 so nothing still points at these elements.

drop microflow if exists ResourceMonitor.ACT_ToggleDetail;

-- user data and raw JMX / system property dumps
drop entity if exists ResourceMonitor.SessionSample;
drop entity if exists ResourceMonitor.MetricSample;
drop entity if exists ResourceMonitor.SystemPropertySample;

ALTER ENTITY ResourceMonitor.Snapshot DROP ATTRIBUTE IF EXISTS ApplicationRootUrl;
ALTER ENTITY ResourceMonitor.Snapshot DROP ATTRIBUTE IF EXISTS NamedUsersConcurrent;
ALTER ENTITY ResourceMonitor.Snapshot DROP ATTRIBUTE IF EXISTS AnonymousSessions;
ALTER ENTITY ResourceMonitor.Snapshot DROP ATTRIBUTE IF EXISTS MaxConcurrentUsers;
